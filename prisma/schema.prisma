// /home/nasser/apps/robotmaker/prisma/schema.prisma
//
// این اسکیما دقیقاً روی جدول موجود bot_menus نگاشت می‌شود.
// جدول از قبل با psql ساخته شده؛ نیازی به migration نیست،
// فقط کافیست `npx prisma generate` اجرا شود تا کلاینت تایپ‌شده ساخته شود.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BotMenu {
  id               Int      @id @default(autoincrement())
  fromId           BigInt   @map("from_id")
  menuName         String   @map("menu_name")
  menuDescription  String?  @map("menu_description")
  menuJson         Json     @map("menu_json")
  botToken         String?  @unique @map("bot_token")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([fromId, menuName], name: "from_id_menu_name")
  @@map("bot_menus")
}

model Profile {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromId              BigInt    @unique @map("from_id")
  phoneNumber         String?   @map("phone_number")
  fullName            String?   @map("full_name")
  telegramUsername    String?   @map("telegram_username")
  telegramFirstName   String?   @map("telegram_first_name")
  telegramLastName    String?   @map("telegram_last_name")
  profileCompletedAt  DateTime? @map("profile_completed_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

model Wallet {
  id            Int      @id @default(autoincrement())
  fromId        BigInt   @unique @map("from_id")
  balanceCoins  Int      @default(0) @map("balance_coins")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("wallets")
}

model Payment {
  id              Int       @id @default(autoincrement())
  fromId          BigInt    @map("from_id")
  amountRial      BigInt    @map("amount_rial")
  verifyPayment   String    @map("verify_payment")
  coinsRequested  Int       @map("coins_requested")
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz

  @@map("payments")
}
